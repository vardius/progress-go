---
// Headline numbers under the hero, read from the same results as the benchmark charts so they can't drift apart.
import { comparison, suite, type Group } from '../data/benchmarks';

const row = (group: Group, scenario: string) => {
	const r = comparison[group].find((r) => r.scenario === scenario);
	if (!r) throw new Error(`no ${group} benchmark named ${scenario}`);
	return r;
};

const bench = (name: string) => {
	const r = suite.find((r) => r.benchmark === name);
	if (!r) throw new Error(`no benchmark named ${name}`);
	return r;
};

const advance = row('advance', '1 goroutine');
const bar = row('bar', '1,000 updates');
const redraw = bench('Redraw');
const hotAllocs = Math.max(advance.after.allocs, redraw.allocs, bench('RedrawVerbose').allocs);

const stats = [
	{ value: `${(advance.before.ns / advance.after.ns).toFixed(0)}×`, label: 'faster to advance than the untagged version' },
	{ value: `${(bar.before.ns / bar.after.ns).toFixed(0)}×`, label: 'faster for a bar of 1,000 updates on a terminal' },
	{ value: `${hotAllocs}`, label: 'allocations to advance or redraw the bar' },
	{ value: `${redraw.ns.toFixed(0)} ns`, label: 'to redraw the bar, written in one Write' },
];
---

<ul class="stats not-content">
	{
		stats.map((s) => (
			<li>
				<span class="value">{s.value}</span>
				<span class="label">{s.label}</span>
			</li>
		))
	}
</ul>

<style>
	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
		gap: 1px;
		margin: 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--sl-color-hairline-light);
	}

	li {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
		padding: 1.25rem 1.5rem;
		background: var(--sl-color-bg);
	}

	.value {
		font-size: var(--sl-text-3xl);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}

	.label {
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		color: var(--sl-color-gray-3);
	}
</style>
